+                if m:
+                    val, unit = float(m.group(1)), m.group(2)
+                    suggested = val / 1000 if unit == "ms" else val * 60 if unit == "m" else val
+                else:
+                    suggested = 2.0 ** attempt
+                # Daily RPD limit has multi-hour waits — bail out immediately rather than sleeping
+                if suggested > 300:
+                    raise RuntimeError(
